# =============================================================================
# DIG_EVI Environment Variables
# =============================================================================

# Server Port
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_evidence_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AES-256-GCM Master Encryption Key (64-character hex string = 32 bytes)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=your_64_char_hex_master_key_here

# Field-Level Database Encryption Key (64-character hex string = 32 bytes)
# Used for encrypting sensitive database columns via AES-256-GCM with HKDF subkeys
DATA_ENCRYPTION_KEY=your_64_char_hex_data_encryption_key_here

# Blind Index Key (64-character hex string = 32 bytes)
# Used for computing HMAC-SHA256 blind indexes for exact-match database queries
BLIND_INDEX_KEY=your_64_char_hex_blind_index_key_here


# =============================================================================
# SMTP Email Notification Configuration (Tamper Alerts)
# =============================================================================
# If left empty, email sending is safely bypassed while database alerts continue.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password for SMTP_PASS
# For Ethereal (Dev/Test): SMTP_HOST=smtp.ethereal.email, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional override; if omitted, alerts are sent to the active System Administrator email in the database
SYSTEM_ADMIN_EMAIL=
# Optional custom sender display address
SMTP_FROM=

